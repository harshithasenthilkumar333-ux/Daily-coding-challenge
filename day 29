1.class NumArray {
    private int[] pre;
    public NumArray(int[] nums) {
        int n = nums.length;
        pre = new int[n+1];

        pre[0] = 0;
        for(int i = 1;i<=n;i++){
            pre[i] = pre[i-1] + nums[i-1];
        }    
    }
    
    public int sumRange(int left, int right) {
        return pre[right+1] - pre[left];
    }
}
2./**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    List<Integer> ans = new ArrayList<>();
    int i = 0;
    public List<Integer> flipMatchVoyage(TreeNode root, int[] voyage) {
        dfs(root, voyage);
        return ans;
    }
    private void dfs(TreeNode root, int[] v){
        if(root == null || (ans.size() > 0 && ans.get(ans.size()-1) == -1)){
            return;
        }
        if(root.val != v[i++]){
            ans = new ArrayList<>();
            ans.add(-1);
        }
        else if(root.left != null && root.left.val != v[i]){
            ans.add(root.val);
            dfs(root.right, v);
            dfs(root.left, v);
        }
        else{
            dfs(root.left, v);
            dfs(root.right, v);
        }
    }
}