1.class Solution {
    public int[] findErrorNums(int[] nums) {
        int n = nums.length;
        int a[] = new int[n + 1];

        for (int i = 0; i < nums.length; i++) {
            a[nums[i]]++;
        }

        int d = 0;
        int m = 0;

        for (int i = 1; i <= n; i++) {
            if (a[i] == 0) {
                m = i;
            } else if (a[i] == 2) {
                d = i;
            }
        }

        return new int[]{d, m};
    }
}
2.class Solution {
    public int findLHS(int[] nums) {
        Arrays.sort(nums);
        int l = 0, r = 1, res = 0;
        while(r < nums.length) {
            int diff = nums[r] - nums[l];
            if(diff == 1) res = Math.max(res, r - l + 1);
            if(diff <= 1) r++;
            else l++;
        }

        return res;
    }
}