1.class Solution {
    public int diagonalSum(int[][] arr) {
        int n = arr.length;
        int sum = 0;

        for(int i=0;i<n;i++){
            sum += arr[i][i] + arr[i][n-i-1];
        }

        if(n%2 == 1) sum -= arr[n/2][n/2];

        return sum;
    }
}
2.class Solution {
    public int xorOperation(int n, int start) {
        int ans = 0;

        while (n-- > 0) {
            ans ^= start;
            start += 2;
        }

        return ans;
    }
}